# انسخه إلى .env وحرّره قبل التشغيل:  cp .env.example .env
# نطاقُ n8n الفرعيّ (وجّهه في DNS إلى خادمك ثم إلى المنفذ 5678 عبر reverse proxy)
N8N_HOST=n8n.yourdomain.com

# مفتاحُ تشفيرٍ ثابت (٣٢ حرفاً فأكثر) — لا تُغيّره بعد أول تشغيل وإلا فقدتَ الاعتمادات
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string

# قاعدة PostgreSQL
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me-strong-password

# المنطقة الزمنية
TZ=Asia/Kuwait
