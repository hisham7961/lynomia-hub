# ─────────────────────────────────────────────────────────────────────────────
# أسماءُ المتغيّراتِ فقط — **لا قيمَ حقيقيّةَ هنا ولا قيمَ افتراضيّةً تعمل**.
#
#   هذا الملفُّ **في المستودع** للتوثيق. والملفّانِ الحقيقيّان يُنشآن على
#   الخادمِ في `/etc/litellm/` بصلاحيّة `0600 root:root` — **خارجَ Git
#   وخارجَ `public_html`**.
#
#   وكلُّ قيمةٍ أدناه مكتوبةٌ `<...>` عمداً: لا placeholder قابلٌ للعملِ في
#   الإنتاج، فلا يُنسى واحدٌ منها فيصير سرّاً معروفاً.
# ─────────────────────────────────────────────────────────────────────────────

# ═══════════ ملفّان منفصلان — أقلُّ امتيازٍ ممكن ═══════════
#
#  /etc/litellm/postgres.env   ← حاويةُ القاعدةِ وحدَها تقرؤه
#  /etc/litellm/litellm.env    ← حاويةُ البوّابةِ وحدَها تقرؤه
#
#  فحاويةُ القاعدةِ **لا ترى** مفتاحَ الإدارةِ ولا مفتاحَ الملح.
#
#  وكيف يصل المحتوى إلى الحاوية؟ **`docker compose` نفسُه يقرأ الملفَّ على
#  المضيفِ وهو يعمل كـroot**، ثمّ يحقن الأزواجَ في الحاويةِ عبر واجهة Docker.
#  **فالملفُّ لا يُركَّب داخلَ الحاويةِ إطلاقاً** — ولا تحتاج الحاويةُ أيَّ
#  صلاحيّةٍ على `/etc/litellm`.
#
#  ⚠️ **وثمنُ حقنِ البيئةِ يُقال صراحةً:** القيمُ تظهر في
#  `docker inspect <الحاوية>` تحت `Config.Env`. فمن يستطيع `docker inspect`
#  يقرأ السرّ. و`lynomia` **لا يستطيع**: ليس في مجموعة `docker` (مقيس:
#  `docker:x:990:` بلا أعضاء) ولا في sudoers. **فلا يُضاف إليها.**


# ─── ملفّ ①: /etc/litellm/postgres.env ───────────────────────────────────────

# كلمةُ مرورِ مستخدمِ القاعدةِ `litellm`. تُولَّد عشوائيّاً على الخادم.
POSTGRES_PASSWORD=<يُولَّد على الخادم — لا يُكتب هنا ولا يُطبَع>


# ─── ملفّ ②: /etc/litellm/litellm.env ────────────────────────────────────────

# مفتاحُ إدارةِ البوّابة. يبدأ بـ`sk-`. يُرسَل ترويسةَ Authorization.
# **قابلٌ للتدوير** — ولـLiteLLM إجراءٌ موثَّقٌ لذلك.
LITELLM_MASTER_KEY=<sk-... يُولَّد على الخادم>

# 🔴 مفتاحُ الملح — يشفّر اعتماداتِ المزوّدين في القاعدة.
#
#    **«Never change this key — encrypted data becomes unrecoverable»**
#    (نصُّ وثيقةِ LiteLLM الرسميّة). ولا هجرةَ في المكانِ لتدويره.
#
#    ويُضبَط **قبل إضافةِ أوّلِ نموذج**. وإن تُرك فارغاً فإنّ LiteLLM يشفّر
#    بـ`LITELLM_MASTER_KEY` بدلاً منه — وحينها **يصير تدويرُ مفتاحِ الإدارةِ
#    مُتلِفاً للاعتمادات**. فضبطُه صراحةً هو ما يُبقي مفتاحَ الإدارةِ قابلاً
#    للتدوير.
#
#    🔑 **يُنسَخ احتياطيّاً قبل أوّلِ استعمال** — فقدُه = فقدُ كلِّ اعتمادِ
#       مزوّدٍ بلا استرجاع.
LITELLM_SALT_KEY=<يُولَّد على الخادم · يُنسَخ فوراً · لا يُغيَّر أبداً>

# سلسلةُ اتصالِ القاعدة. المضيفُ **اسمُ الخدمةِ** لا عنوانٌ.
# وهي سلسلةُ اتصالٍ **لا تشفّر شيئاً** — فتغييرُها ممكنٌ (تدويرُ كلمةِ مرورٍ
# مثلاً) ما دامت تشير إلى البياناتِ نفسِها.
DATABASE_URL=postgresql://litellm:<كلمة المرور نفسها>@litellm-postgres:5432/litellm
