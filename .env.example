APP_NAME="Lynomia Business Hub"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Kuwait
APP_URL=https://hub.lynomia.com
APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lynomia_hub
DB_USERNAME=lynomia_hub
DB_PASSWORD=

SESSION_DRIVER=file
# ١٢ ساعة (كانت سنةً كاملة): «تذكّرني» يُعيد الدخول للأجهزة الموثوقة، والجلسةُ نفسُها لا تعيش سنة
SESSION_LIFETIME=720
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public
MAIL_MAILER=log

# ── قاعدةُ العقل الثاني المستقلّة (اختياريّة) ──
# متّجهاتُ البحث بالمعنى في قاعدةٍ وحدَها — لا تمسّ القاعدةَ الرئيسة، ويُرقّى محرّكُها وحدَه متى شئت.
# فارغٌ = في القاعدة الرئيسة. بعد الضبط: php artisan hub:brain --setup
# الانتقالُ لا ينقل المتّجهاتِ القديمة: تُعاد الفهرسةُ في المستقلّة، والقديمةُ تُمحى بـ --setup --purge-main
# BRAIN_DB_CONNECTION=brain
# BRAIN_DB_DRIVER=mysql            # أو sqlite (ملفٌّ واحدٌ بلا خادم: database/brain.sqlite)
# BRAIN_DB_HOST=127.0.0.1
# BRAIN_DB_PORT=3306
# BRAIN_DB_DATABASE=lynomia_brain
# BRAIN_DB_USERNAME=
# BRAIN_DB_PASSWORD=
